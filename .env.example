# Configurar en .env.local o en las variables de entorno de Vercel.
# No incluir claves secretas ni valores reales en GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IA: apagada hasta configurar cuotas compartidas. Solo servidor, nunca NEXT_PUBLIC.
AI_ENABLED=false
AI_VOICE_ENABLED=false
AI_ITINERARY_ENABLED=false
# Selector de voz solo en servidor: openai o elevenlabs.
# Sin definir: OpenAI en Production; Sofía en la Preview autorizada.
# AI_VOICE_PROVIDER=openai
OPENAI_API_KEY=
TRAVELPAYOUTS_API_TOKEN=
AI_REDIS_REST_URL=
AI_REDIS_REST_TOKEN=
AI_RATE_LIMIT_SECRET=
# Cuotas propuestas; ventanas de 60 segundos / 24 horas desde la primera petición.
AI_VOICE_MINUTE_LIMIT=2
AI_VOICE_DAY_LIMIT=5
AI_VOICE_GLOBAL_DAY_LIMIT=20
AI_ITINERARY_MINUTE_LIMIT=3
AI_ITINERARY_DAY_LIMIT=10
AI_ITINERARY_GLOBAL_DAY_LIMIT=50

# Sofía: requiere clave independiente, licencia y autorización antes de Production.
ELEVENLABS_ENABLED=false
ELEVENLABS_PRODUCTION_APPROVED=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_VERSION_ID=
# Three admissions reserve up to 15 minutes in a fixed 31-day window.
# Separate LLM costs, other integrations and token reuse are not a monetary cap.
AI_VOICE_GLOBAL_31DAY_LIMIT=3
